# Vamanan GPT Environment Variables
# Copy this file to .env and fill in your values

# Option 1: Direct OpenAI API Key (frontend - use for development only)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Backend API URL (recommended for production)
# Point this to your deployed backend API
VITE_API_URL=https://your-backend-api.vercel.app
